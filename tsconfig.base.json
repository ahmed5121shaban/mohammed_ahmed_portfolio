{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@kola-profile/shared-util": ["./libs/shared/shared-util/src/index.ts"],
      "@kola-profile/domain": ["./libs/domain/src/index.ts"],
      "@kola-profile/application": ["./libs/application/src/index.ts"],
      "@kola-profile/infrastructure-data": [
        "./libs/infrastructure/infrastructure-data/src/index.ts"
      ],
      "@kola-profile/infrastructure-three": [
        "./libs/infrastructure/infrastructure-three/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
